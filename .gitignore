# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local dev
/supabase/.branches
/supabase/.temp

# reference material (PRD, brochure, raw logo originals) — archived locally,
# not versioned: large binaries, not application source.
/reference/

# Auction player source data (2026-08-18): the raw deck (114MB, exceeds
# GitHub's 100MB push limit) and the unreliable Codex-merged CSV it
# superseded. Neither is application source; scripts/build-auction-import.py
# is the code, auction_players_import.csv is its (small, kept) output.
/*.pptx
/merged_auction_players_updated.csv

# Playwright auth storage states (session cookies, per-run — gitignored, not secrets, just noise)
/tests/e2e/.auth/
